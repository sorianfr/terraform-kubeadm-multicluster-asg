apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  variant: Calico
  registry: ""
  kubernetesProvider: Kubernetes
  calicoNetwork:
    bgp: Enabled
    ipPools:
      - blockSize: 26
        cidr: "{{ pod_network_cidr }}"
        encapsulation: VXLANCrossSubnet
        natOutgoing: Enabled
        nodeSelector: all()

